{
  "name": "mnest-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ../vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build --config ../vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest --config ../vite.config.ts run",
    "test:watch": "vitest --config ../vite.config.ts"
  },
  "dependencies": {
    "@solidjs/router": "latest",
    "lucide-solid": "latest",
    "solid-js": "latest"
  },
  "devDependencies": {
    "@solidjs/testing-library": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@types/node": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-solid": "latest",
    "vitest": "latest"
  }
}
